# ZoliBlog — copier vers .env : cp .env.example .env
#
# Build production des fronts : cp .env.production.example .env.production (gitignoré)
# Éditer VITE_API_URL — le modèle .env.production.example est versionné dans Git.

DATABASE_URL=jdbc:postgresql://localhost:5432/java_blog
POSTGRES_USER=NomUser
POSTGRES_PASSWORD=motDePasse

JWT_SECRET=
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=INFO
SECURITY_LOGIN_RATE_LIMIT_ENABLED=true