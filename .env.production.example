# Modèle pour build front en mode production EN LOCAL uniquement :
#   cp .env.production.example .env.production
# puis adapter VITE_API_URL (API locale ou URL Railway pour un test manuel).
#
# GitHub Pages (CI) : le workflow injecte vars.VITE_API_URL — ne pas committer .env.production.
# Secrets API (JWT, BDD) : variables Railway sur le service API, pas ce fichier.
# VITE_API_URL n’est pas secret (visible dans le JS navigateur).

VITE_API_URL=http://localhost:8080
