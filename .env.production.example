# Modèle versionné — copier avant un build prod local :
#   cp .env.production.example .env.production
# Puis éditer VITE_API_URL (URL Render publique, sans slash final).
# En CI (deploy Pages), le workflow copie ce fichier vers .env.production.
#
# Non secret : l’URL est visible dans le JavaScript du navigateur.

VITE_API_URL=https://CHANGE_ME.onrender.com
